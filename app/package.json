{
  "name": "agi-is-here-app",
  "version": "1.2.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "e2e": "playwright test --grep-invert '@perf|@walkthrough-full'",
    "e2e:perf": "playwright test --grep @perf --workers=1",
    "e2e:walkthrough-full": "playwright test --grep @walkthrough-full",
    "e2e:webkit": "playwright test --config playwright.webkit.config.ts",
    "e2e:webkit-desktop": "playwright test --config playwright.webkit.config.ts --project=desktop-webkit",
    "e2e:phone": "playwright test --config playwright.webkit.config.ts --project=iphone-webkit",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.worker.json",
    "e2e:production": "playwright test --config playwright.production.config.ts --grep-invert @perf",
    "e2e:production:perf": "playwright test --config playwright.production.config.ts --browser=chromium --grep @perf --workers=1",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "monaco-editor": "0.57.0",
    "openai": "^7.47.0",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-dom": "^3.5.44",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "3.3.14"
  }
}

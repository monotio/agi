    "@playwright/test": "^1.63.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}

{
  // Worker-only program: same strictness as tsconfig.json, but with the
  // WebWorker lib instead of DOM so `self` is a DedicatedWorkerGlobalScope.
  // The two libs redeclare the same globals and cannot share one program.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "WebWorker"],
    "types": []
  },
  "include": [
    "src/worker/engine.worker.ts",
    "src/library/preview.worker.ts",
    "src/studio/route.worker.ts",
    "src/studio/logic/analysis.worker.ts"
  ],
  "exclude": []
}

{
  "name": "agi-is-here-evals",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authoring evaluations and regression checks for AGI IS HERE.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "eval": "promptfoo eval -c configs/genesis.ts",
    "eval:effort": "promptfoo eval -c configs/effort.ts",
    "eval:replay": "cd .. && node --test --experimental-strip-types \"evals/tests/**/*.test.ts\"",
    "test": "npm run eval:replay"
  },
  "devDependencies": {
    "promptfoo": "0.122.2"
  }
}

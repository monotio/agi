{
  "name": "agi-is-here",
  "version": "1.2.2",
  "description": "Create, play and remix authentic AGI adventures with AI. Open-source TypeScript engine and browser authoring tools by Monotio.",
  "private": true,
  "workspaces": [
    "app"
  ],
  "keywords": [
    "agi",
    "sierra",
    "adventure-games",
    "interpreter",
    "typescript",
    "game-editor"
  ],
  "type": "module",
  "bin": {
    "agi-language-server": "scripts/agi-language-server.ts"
  },
  "license": "MIT",
  "author": "Joakim Riedel <joakim@monotio.com>",
  "homepage": "https://agi.monotio.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotio/agi.git"
  },
  "bugs": {
    "url": "https://github.com/monotio/agi/issues"
  },
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "npm --prefix app run dev -- --port 5199",
    "build": "tsc -p tsconfig.json && npm --prefix app run build && npm run check:bundle -- --warn",
    "check:bundle": "node --experimental-strip-types scripts/check-bundle-budget.ts",
    "verify:deploy": "node --experimental-strip-types scripts/verify-deploy.ts",
    "test": "node --test --experimental-strip-types 'test/*.test.ts'",
    "test:app": "node --test --experimental-strip-types 'app/test/*.test.ts'",
    "test:e2e": "npm --prefix app run e2e",
    "prove:walkthrough": "node --experimental-strip-types scripts/walkthrough.ts",
    "walkthrough:generate": "node --experimental-strip-types scripts/generate-walkthroughs.ts",
    "media:capture": "node --experimental-strip-types scripts/capture-media.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p evals/tsconfig.json --noEmit",
    "typecheck:app": "npm --prefix app run typecheck",
    "check:dependencies": "npm ls --depth=0 && node --experimental-strip-types scripts/check-engine-dependencies.ts",
    "check": "run-s check:dependencies typecheck typecheck:app lint lint:ast lint:dead lint:deps lint:tokens format:check test test:app eval:replay",
    "eval:genesis": "node --experimental-strip-types evals/genesis-cli.ts",
    "eval:image-style": "node --experimental-strip-types evals/image-style.ts",
    "eval:picture": "node --experimental-strip-types evals/picture-fidelity.ts",
    "eval:remix": "node --experimental-strip-types evals/remix-benchmark.ts",
    "eval:references": "node --experimental-strip-types evals/reference-benchmark.ts",
    "eval:cache": "node --experimental-strip-types evals/cache-probe.ts",
    "eval:matrix": "node --experimental-strip-types evals/genesis-matrix.ts",
    "eval:snapshot": "node --experimental-strip-types evals/snapshot-genesis.ts",
    "fixtures:audit": "node --experimental-strip-types scripts/audit-fixtures.ts",
    "conformance": "node --experimental-strip-types scripts/conformance.ts",
    "eval:replay": "node --test --experimental-strip-types 'evals/tests/**/*.test.ts'",
    "eval": "npm --prefix evals run eval --",
    "language-server": "node --experimental-strip-types scripts/agi-language-server.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:dead": "knip",
    "lint:deps": "node scripts/lint-deps.mjs",
    "mutation": "stryker run",
    "mutation:test": "node --test --experimental-strip-types 'test/picture*.test.ts' 'test/studio*.test.ts'",
    "lint:fix": "eslint . --fix",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:ast": "node scripts/check-ast-grep-suppressions.mjs && ast-grep scan -c .ast-grep/sgconfig.yml --error && ast-grep test -c .ast-grep/sgconfig.yml",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.16"
    },
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.50.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-protocol": "3.18.4",
    "vue-eslint-parser": "^10.4.1"
  }
}

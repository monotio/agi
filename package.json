{
  "name": "agi-is-here",
  "version": "1.0.0",
  "description": "Create, play and remix authentic AGI adventures with AI. Open-source TypeScript engine and browser authoring tools by Monotio.",
  "type": "module",
  "license": "MIT",
  "author": "Joakim Riedel <joakim@monotio.com>",
  "homepage": "https://monotio.com/agi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotio/agi.git"
  },
  "bugs": {
    "url": "https://github.com/monotio/agi/issues"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "npm --prefix app run dev -- --port 5199",
    "build": "tsc -p tsconfig.json && npm --prefix app run build",
    "test": "node --test --experimental-strip-types 'test/*.test.ts'",
    "test:app": "node --test --experimental-strip-types 'app/test/*.test.ts'",
    "test:e2e": "npm --prefix app run e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:app": "npm --prefix app run typecheck",
    "check": "run-s typecheck typecheck:app lint format:check test test:app eval:replay",
    "eval:genesis": "node --experimental-strip-types scripts/eval-genesis.ts",
    "eval:picture": "node --experimental-strip-types scripts/eval-picture.ts",
    "conformance": "node --experimental-strip-types scripts/conformance.ts",
    "eval:replay": "node --test --experimental-strip-types 'evals/tests/**/*.test.mjs'",
    "eval": "npx --prefix evals promptfoo eval -c configs/genesis.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast": "ast-grep scan -c .ast-grep/sgconfig.yml",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^8.0.4",
    "openai": "^7.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vue-eslint-parser": "^10.4.1"
  }
}

{
  "name": "agi-is-here",
  "version": "1.0.0-rc.6",
  "description": "Create, play and remix authentic AGI adventures with AI. Open-source TypeScript engine and browser authoring tools by Monotio.",
  "type": "module",
  "license": "MIT",
  "author": "Joakim Riedel <joakim@monotio.com>",
  "homepage": "https://agi.monotio.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotio/agi.git"
  },
  "bugs": {
    "url": "https://github.com/monotio/agi/issues"
  },
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "npm --prefix app run dev -- --port 5199",
    "build": "tsc -p tsconfig.json && npm --prefix app run build",
    "test": "node --test --experimental-strip-types 'test/*.test.ts'",
    "test:app": "node --test --experimental-strip-types 'app/test/*.test.ts'",
    "test:e2e": "npm --prefix app run e2e",
    "prove:walkthrough": "node --experimental-strip-types scripts/walkthrough.ts",
    "walkthrough:generate": "node --experimental-strip-types scripts/generate-walkthroughs.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p evals/tsconfig.json --noEmit",
    "typecheck:app": "npm --prefix app run typecheck",
    "check:dependencies": "npm ls --depth=0 && npm --prefix app ls --depth=0",
    "check": "run-s check:dependencies typecheck typecheck:app lint lint:ast format:check test test:app eval:replay",
    "eval:genesis": "node --experimental-strip-types scripts/eval-genesis.ts",
    "eval:picture": "node --experimental-strip-types scripts/eval-picture.ts",
    "fixtures:audit": "node --experimental-strip-types scripts/audit-fixtures.ts",
    "conformance": "node --experimental-strip-types scripts/conformance.ts",
    "eval:replay": "node --test --experimental-strip-types 'evals/tests/**/*.test.ts'",
    "eval": "npm --prefix evals run eval --",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:ast": "node scripts/check-ast-grep-suppressions.mjs && ast-grep scan -c .ast-grep/sgconfig.yml --error",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@ast-grep/cli": "0.45.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "openai": "^7.10.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vue-eslint-parser": "^10.4.1"
  }
}

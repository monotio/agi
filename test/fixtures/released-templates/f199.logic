#define C_ABOUT 212
#define C_INVENTORY 213
#message 1 "File"
#message 2 "Save Game      F5"
#message 3 "Restore Game   F7"
#message 4 "Restart Game   F9"
#message 5 "Quit          Alt+Z"
#message 6 "Speed"
#message 7 "Slow"
#message 8 "Normal"
#message 9 "Fast"
#message 10 "Fastest"
#message 11 "Sound"
